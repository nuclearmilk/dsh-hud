{
  "name": "dsh-hud",
  "version": "1.6.0",
  "description": "Cappella-style floating bubble task notification HUD for DeepSeek Harness desktop; provisions its own Electron runtime",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "runtime",
    "docs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nuclearmilk/dsh-hud.git"
  },
  "homepage": "https://github.com/nuclearmilk/dsh-hud#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "hud",
    "notification"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
